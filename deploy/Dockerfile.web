FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# Avoid the Turbopack build path when building amd64 images under QEMU on ARM.
RUN npm run build -- --webpack

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000 PROJECT_ROOT=/app DATABASE_PATH=/data/lightning-lane.sqlite
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
# The generated server uses CommonJS, while the root package declares ESM.
COPY --from=build --chown=node:node /app/apps/web/.next/standalone/apps/web/server.js ./apps/web/server.cjs
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /app/apps/web/public ./apps/web/public
COPY --from=build --chown=node:node /app/packages/db ./packages/db
COPY --chown=node:node deploy/start-web.mjs ./deploy/start-web.mjs
RUN mkdir /data && chown node:node /data
USER node
CMD ["node","deploy/start-web.mjs"]
