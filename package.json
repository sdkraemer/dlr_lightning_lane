{
  "name": "dlr-lightning-lane",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/web.mjs dev",
    "build": "node scripts/web.mjs build",
    "format": "prettier --write .",
    "start": "node scripts/web.mjs start",
    "typecheck": "tsc --noEmit",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.ts",
    "probe": "node --env-file-if-exists=.env scripts/probe.ts",
    "worker": "node --env-file-if-exists=.env apps/worker/src/main.ts",
    "test": "node --test tests/*.test.ts",
    "vapid:generate": "node scripts/vapid.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/backup-db.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "dev:mock": "node scripts/web.mjs dev --mock"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.31.0",
    "@js-temporal/polyfill": "^0.5.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
