DATABASE_PATH=./data/lightning-lane.sqlite
POLL_INTERVAL_SECONDS=120
MONITORING_ENABLED=true
# Default off; only supported by npm run dev (bound to 127.0.0.1).
DEV_MOCK_AUTH=false
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Random 32-byte hex secret. Keep real values out of Git.
AUTH0_SECRET=
AUTH0_ALLOWED_SUB=
# Generate once with npm run vapid:generate, then keep stable across deploys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Production Compose:
APP_DOMAIN=
IMAGE_TAG=local
