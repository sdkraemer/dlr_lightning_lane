DATABASE_PATH=./data/lightning-lane.sqlite
POLL_INTERVAL_SECONDS=120
MONITORING_ENABLED=true
# Default off; only supported by npm run dev (bound to 127.0.0.1).
DEV_MOCK_AUTH=false
# npm development URL; compose.override.yaml supplies https://localhost for Docker.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Random 32-byte hex secret. Keep real values out of Git.
AUTH0_SECRET=
# Optional: assign unowned pre-multi-user data to this existing Auth0 User ID.
# This is migration-only; it does not restrict who can sign up or sign in.
AUTH0_ALLOWED_SUB=
# Generate once with npm run vapid:generate, then keep stable across deploys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Production Compose only; local compose.override.yaml supplies these settings.
APP_DOMAIN=
IMAGE_TAG=local
